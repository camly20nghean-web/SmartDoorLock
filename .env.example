# ==========================================
# SMART DOOR LOCK - CONFIGURATION TEMPLATE
# ==========================================

# Camera Settings
CAMERA_INDEX=0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_FPS=30

# ESP32-S3-CAM Settings (Scheduled for Phase 6)
ESP32_STREAM_URL=http://192.168.1.100:81/stream
ESP32_TIMEOUT_SECONDS=5.0

# Hardware Lock Settings
LOCK_AUTO_RELOCK_SECONDS=5.0
LOCK_FAIL_SECURE=True

# Biometric Verification Thresholds (Scheduled for Phase 3 & 4)
FACE_SIMILARITY_THRESHOLD=0.60
PALM_SIMILARITY_THRESHOLD=0.70

# Database Settings
DATABASE_PATH=sqlite:///./smart_door_lock.db

